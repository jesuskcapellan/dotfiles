#!/usr/bin/env bash

set -e  # Exit on error
set -u  # Exit on undefined variable

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
NODE_VERSION="18"
NVIM_VERSION="stable"
BACKUP_DIR="$HOME/.dotfiles_backup/$(date +%Y%m%d_%H%M%S)"

# Helper functions
log() {
    echo -e "${GREEN}[SETUP]${NC} $1"
}

info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
    exit 1
}

backup_if_exists() {
    if [ -e "$1" ]; then
        local backup_path="$BACKUP_DIR$(dirname "$1")"
        mkdir -p "$backup_path"
        mv "$1" "$backup_path/"
        log "Backed up $1 to $backup_path/"
    fi
}

check_cmd() {
    if ! command -v "$1" &> /dev/null; then
        return 1
    fi
    return 0
}

# Detect OS and shell
OS="unknown"
if [[ "$OSTYPE" == "darwin"* ]]; then
    OS="macos"
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    OS="linux"
else
    error "Unsupported operating system: $OSTYPE"
fi

# Detect current shell
CURRENT_SHELL=$(basename "$SHELL")
info "Detected OS: $OS"
info "Current shell: $CURRENT_SHELL"

# Create backup directory
mkdir -p "$BACKUP_DIR"

log "Setting up your $OS environment..."

# Install package manager if needed (for macOS)
if [ "$OS" = "macos" ]; then
    if ! check_cmd brew; then
        log "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || error "Failed to install Homebrew"
        eval "$(/opt/homebrew/bin/brew shellenv)" # Add Homebrew to PATH
    fi
fi

# Install basic dependencies
log "Installing basic dependencies..."
if [ "$OS" = "linux" ]; then
    if ! check_cmd apt-get; then
        error "This Linux setup requires apt-get. Please adapt the script for your package manager."
    fi
    sudo apt-get update || error "Failed to update package list"
    sudo apt-get install -y git stow tmux fzf curl build-essential ninja-build gettext cmake unzip zsh || error "Failed to install basic packages"
elif [ "$OS" = "macos" ]; then
    brew update || error "Failed to update Homebrew"
    brew install git stow tmux fzf curl cmake ninja gettext || error "Failed to install basic packages"
fi

# Backup existing configs
log "Backing up existing configurations..."
backup_if_exists "$HOME/.bashrc"
backup_if_exists "$HOME/.zshrc"
backup_if_exists "$HOME/.bash_aliases"
backup_if_exists "$HOME/.config/nvim"
backup_if_exists "$HOME/.config/tmux"
backup_if_exists "$HOME/.gitconfig"
backup_if_exists "$HOME/.local/bin/sesh"

# Install Neovim
if ! check_cmd nvim; then
    log "Installing Neovim..."
    
    if [ "$OS" = "macos" ]; then
        brew install neovim || error "Failed to install Neovim"
    else
        if [ ! -d "$HOME/programs" ]; then
            mkdir -p "$HOME/programs"
        fi
        
        if [ -d "$HOME/programs/nvim" ]; then
            rm -rf "$HOME/programs/nvim"
        fi
        
        git clone https://github.com/neovim/neovim "$HOME/programs/nvim" || error "Failed to clone Neovim repository"
        cd "$HOME/programs/nvim"
        git checkout "$NVIM_VERSION"
        make CMAKE_BUILD_TYPE=RelWithDebInfo || error "Failed to build Neovim"
        sudo make install || error "Failed to install Neovim"
        cd "$HOME"
    fi
fi

# Setup dotfiles
log "Setting up dotfiles..."
if [ ! -d "$HOME/.dotfiles" ]; then
    git clone https://github.com/jesuskcapellan/dotfiles.git "$HOME/.dotfiles" || error "Failed to clone dotfiles repository"
fi

cd "$HOME/.dotfiles"

# Create necessary directories
mkdir -p "$HOME/.config/nvim"
mkdir -p "$HOME/.config/tmux"
mkdir -p "$HOME/.local/bin"

# Stow configurations
log "Linking configurations..."

# Neovim configuration
stow --target="$HOME/.config/nvim" nvim || error "Failed to stow nvim config"

# Tmux configuration
stow --target="$HOME/.config/tmux" tmux || error "Failed to stow tmux config"

# Install TPM (Tmux Plugin Manager)
log "Setting up Tmux Plugin Manager..."
TPM_DIR="$HOME/.config/tmux/plugins/tpm"
if [ ! -d "$TPM_DIR" ]; then
    git clone https://github.com/tmux-plugins/tpm "$TPM_DIR" || error "Failed to clone TPM repository"
    # Initial install of plugins
    "$TPM_DIR/bin/install_plugins" || warn "Failed to install tmux plugins automatically - please run prefix + I in tmux to install manually"
fi

# Shell configurations - setup both bash and zsh
log "Setting up shell configurations..."

# Setup bash configuration
if [ -d "bash" ]; then
    stow --target="$HOME" bash || warn "Failed to stow bash configuration"
    info "Bash configuration linked"
fi

# Setup zsh configuration (create if doesn't exist)
if [ -d "zsh" ]; then
    stow --target="$HOME" zsh || warn "Failed to stow zsh configuration"
    info "Zsh configuration linked"
else
    warn "No zsh configuration found in dotfiles - you may need to create one"
fi

# Git configuration
if [ -f ".gitconfig" ]; then
    stow --target="$HOME" . --ignore="install|README.md|.git.*" || warn "Failed to stow git configuration"
fi

# Setup extras
log "Setting up additional tools..."
cd extras

# Starship prompt
if [ -d "starship" ]; then
    stow --target="$HOME/.config" starship || error "Failed to stow starship config"
fi

# Tmux sessionizer (legacy support)
if [ -d "tmux-sessionizer" ]; then
    stow --target="$HOME/.local/bin" tmux-sessionizer || warn "Failed to stow tmux-sessionizer"
fi

# Setup sesh script (enhanced session manager)
log "Setting up sesh script..."
if [ -f "$HOME/.local/bin/sesh" ]; then
    info "Sesh script already exists in ~/.local/bin/sesh"
    chmod +x "$HOME/.local/bin/sesh"
else
    warn "Sesh script not found - you may need to copy it manually to ~/.local/bin/sesh"
fi

# Setup scripts folder if it exists
cd "$HOME/.dotfiles"
if [ -d "scripts" ]; then
    log "Setting up scripts folder..."
    stow --target="$HOME/.local/bin" scripts || warn "Failed to stow scripts"
    # Make all scripts executable
    find "$HOME/.local/bin" -type f -name "*.sh" -exec chmod +x {} \;
    find "$HOME/.local/bin" -type f -name "sesh" -exec chmod +x {} \;
    info "Scripts folder linked and made executable"
else
    info "No scripts folder found in dotfiles"
fi

# Install Node via nvm
if ! check_cmd node; then
    log "Installing Node.js..."
    export NVM_DIR="$HOME/.nvm"
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash || error "Failed to install nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # Load nvm
    nvm install "$NODE_VERSION" || error "Failed to install Node.js"
    nvm use "$NODE_VERSION" || error "Failed to use Node.js version $NODE_VERSION"
fi

# Setup Starship prompt
if ! check_cmd starship; then
    log "Installing Starship prompt..."
    curl -sS https://starship.rs/install.sh | sh || error "Failed to install Starship"
fi

# Final setup and shell detection
log "Finalizing setup..."

# Ensure .local/bin is in PATH for both shells
if ! grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$HOME/.bashrc" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
fi

if [ -f "$HOME/.zshrc" ] && ! grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$HOME/.zshrc" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.zshrc"
fi

# Source the appropriate shell configuration
log "Reloading shell configuration..."
case "$CURRENT_SHELL" in
    "zsh")
        if [ -f "$HOME/.zshrc" ]; then
            info "Zsh configuration ready - restart your terminal or run: source ~/.zshrc"
        fi
        ;;
    "bash")
        if [ -f "$HOME/.bashrc" ]; then
            info "Bash configuration ready - restart your terminal or run: source ~/.bashrc"
        fi
        ;;
    *)
        warn "Unknown shell: $CURRENT_SHELL - you may need to manually configure your shell"
        ;;
esac

log "Setup completed successfully! 🎉"
echo ""
info "Summary of what was set up:"
info "  ✓ Neovim configuration"
info "  ✓ Tmux configuration with TPM"
info "  ✓ Shell configurations (bash/zsh support)"
info "  ✓ Starship prompt"
info "  ✓ Sesh session manager"
info "  ✓ Git configuration"
info "  ✓ Node.js via nvm"
echo ""
info "Backup of old configurations: $BACKUP_DIR"
echo ""
warn "Important next steps:"
warn "  1. Restart your terminal for all changes to take effect"
warn "  2. Run 'tmux' and press prefix + I to install tmux plugins"
warn "  3. Open nvim to let plugins install automatically"
if [ "$CURRENT_SHELL" = "zsh" ] && [ ! -d "$HOME/.dotfiles/zsh" ]; then
    warn "  4. Consider creating a zsh configuration in ~/.dotfiles/zsh/"
fi
