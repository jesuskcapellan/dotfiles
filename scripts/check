#!/bin/zsh
# Enhanced git status with additional information

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "❌ Error: Not in a git repository"
    exit 1
fi

echo "📊 Repository Status"
echo "==================="

# Current branch info
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "HEAD" ]; then
    echo "📍 Branch: (detached HEAD)"
else
    echo "📍 Branch: $current_branch"
fi

latest_commit=$(git log -1 --pretty=%B 2>/dev/null)
echo "⭐ Latest commit: \"$latest_commit\""

# Check if branch has upstream
if git rev-parse --abbrev-ref @{upstream} > /dev/null 2>&1; then
    upstream=$(git rev-parse --abbrev-ref @{upstream})
    echo "🌐 Upstream: $upstream"
    
    # Check how many commits ahead/behind
    commits_ahead=$(git rev-list --count @{upstream}..HEAD 2>/dev/null || echo "0")
    commits_behind=$(git rev-list --count HEAD..@{upstream} 2>/dev/null || echo "0")

    
    if [ "$commits_ahead" -gt 0 ]; then
        echo "📈 Ahead: $commits_ahead commit(s)"
    fi
    
    if [ "$commits_behind" -gt 0 ]; then
        echo "📉 Behind: $commits_behind commit(s)"
    fi
    
    if [ "$commits_ahead" -eq 0 ] && [ "$commits_behind" -eq 0 ]; then
        echo "✅ Up to date with upstream"
    fi
else
    echo "⚠️  No upstream branch set"
fi

echo ""

# Git status
git status --short --branch

# Show stash info if any
stash_count=$(git stash list | wc -l | tr -d ' ')
if [ "$stash_count" -gt 0 ]; then
    echo ""
    echo "💾 Stashes: $stash_count"
    git stash list --color=always | echo
fi
